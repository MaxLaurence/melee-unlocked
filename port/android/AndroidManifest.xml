<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app: LauncherActivity (disc, Slippi sign-in, Play), MeleeActivity (the game, SDL's
     activity, in a process of its own so leaving the game returns to the launcher) and
     SlippiLoginActivity (slippi.gg's sign-in page). versionCode and versionName come from build-apk.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.meleeunlocked"
    android:installLocation="auto">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- SDL hints (SDL reads SDL_ENV.* meta-data into the environment). The Back button reaches the
             game instead of closing it. -->
        <meta-data android:name="SDL_ENV.SDL_ANDROID_TRAP_BACK_BUTTON" android:value="1" />
        <!-- Landscape only, either way up (SDL otherwise lets a resizable window take any orientation,
             and a handheld's portrait panel then shows the game sideways). -->
        <meta-data android:name="SDL_ENV.SDL_IOS_ORIENTATIONS" android:value="LandscapeLeft LandscapeRight" />

        <activity android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MeleeActivity"
            android:process=":game"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:preferMinimalPostProcessing="true"
            android:resizeableActivity="false"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <!-- A GameCube adapter plugged in: the game is offered for it (GcAdapterAccess). -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" android:resource="@xml/gc_adapter" />
        </activity>

        <activity android:name=".SlippiLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
    </application>
</manifest>
